# The single upstream pin for xscaler-collector. Every module in builder.yaml,
# the supervisor build and the OBI generate step read their versions from here;
# scripts/check-pins.sh fails CI when builder.yaml drifts from this file.
#
# Bumping: change OTEL_VERSION and OTEL_STABLE_VERSION together (the pair is in
# opentelemetry-collector's versions.yaml for that tag), take
# CONTRIB_STABLE_VERSION from contrib's versions.yaml at the same tag, move OBI_VERSION to the
# OBI release whose collector/go.mod requires that same core version, then run
# `make manifest` and `make check`. See README.md "Bumping the pin".

# Collector core beta modules and every contrib module.
OTEL_VERSION=0.163.0
# Collector core stable modules (pdata, component, confmap providers, ...).
OTEL_STABLE_VERSION=1.69.0
# Contrib's stable-base module set (contrib versions.yaml at v$OTEL_VERSION)
# and the modules in it that builder.yaml uses.
CONTRIB_STABLE_VERSION=1.2.0
CONTRIB_STABLE_MODULES="processor/k8sattributesprocessor"
# OpenTelemetry eBPF Instrumentation. v0.15.2's collector module requires
# core v0.163.0 / pdata v1.69.0.
OBI_VERSION=0.15.2
# The image OBI's own Makefile uses for `make generate` at OBI_VERSION.
OBI_GENERATOR_VERSION=0.2.17
GO_VERSION=1.27
