# Local supervisor state
/tmp/
supervisor/

# Local supervisor configs — these carry a real enrollment token, keep them out
supervisor.yaml
*.supervisor.yaml

# Vendored subchart archives — fetched by `helm dependency build` from the
# versions Chart.lock pins, so the tgz files don't belong in git.
/charts/*/charts/

# OS / editor cruft
.DS_Store
*.swp
