# Environment for the xscaler-collector service. supervisor.yaml reads these
# through ${env:...}. Restart the service after editing:
#
#   systemctl restart xscaler-collector

# Enrollment token from the xScaler portal (xse_...).
XSCALER_ENROLLMENT_TOKEN=

# OpAMP endpoint the supervisor enrolls with.
XSCALER_ENDPOINT=wss://agents.xscalerlabs.com/v1/opamp

# Name shown for this agent in the portal. Empty means the host name.
XSCALER_AGENT_NAME=
